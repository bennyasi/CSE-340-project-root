<%- include('partials/header') %>

<main class="container">
    <header class="page-header">
        <h1><%= title %></h1>
    </header>

    <% if (categoryDetails) { %>
        <section class="category-meta">
            <h2>
                Category:
                <span class="highlight-text">
                    <%= categoryDetails.name %>
                </span>
            </h2>
        </section>
    <% } %>

    <section class="category-projects-section">
        <h3>Projects in this Category</h3>

        <ul class="project-list-grid">
            <% if (projects && projects.length > 0) { %>

                <% projects.forEach(project => { %>
                    <li class="project-card-item">
                        <strong class="project-card-title">
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </strong>

                        <p class="project-card-desc">
                            <%= project.description %>
                        </p>
                    </li>
                <% }) %>

            <% } else { %>

                <li class="no-data-msg">
                    No projects are currently assigned to this category.
                </li>

            <% } %>
        </ul>
    </section>

    <p>
        <a href="/categories" class="btn btn-secondary">
            ← Back to Categories
        </a>
    </p>
</main>

<%- include('partials/footer') %>
<%- include('partials/header') %>
<main style="max-width: 600px; margin: 40px auto; padding: 0 20px;">
    <h1>Edit Organization</h1>

    <% if (locals.messages && messages.error) { %>
        <div class="alert alert-danger" style="background: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 20px; border-radius: 4px;">
            <%= messages.error %>
        </div>
    <% } %>

    <form action="/organizations/update/<%= organization.organization_id %>" method="POST">
        <div class="form-group" style="margin-bottom: 15px;">
            <label for="name">Organization Name</label>
            <input type="text" id="name" name="name" value="<%= organization.name %>" minlength="3" maxlength="150" required style="width: 100%; padding: 8px;" />
        </div>
        <div class="form-group" style="margin-bottom: 15px;">
            <label for="description">Description</label>
            <textarea id="description" name="description" maxlength="500" required style="width: 100%; padding: 8px; height: 100px;"><%= organization.description %></textarea>
        </div>
        <div class="form-group" style="margin-bottom: 20px;">
            <label for="contactEmail">Contact Email</label>
            <input type="email" id="contactEmail" name="contactEmail" value="<%= organization.contact_email %>" required style="width: 100%; padding: 8px;" />
        </div>
        <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px;">Update Organization</button>
        <a href="/organizations" style="margin-left: 15px;">Cancel</a>
    </form>
</main>
<%- include('partials/footer') %>
<%- include('../partials/header') %>

<main class="container form-container">
    <header class="page-header">
        <h1><%= title %></h1>
    </header>

    <%- include('../partials/messages') %>

    <div class="form-card">
        <form action="/categories/edit/<%= category.category_id %>" method="POST" class="interactive-form">
            
            <div class="form-group">
                <label for="name" class="form-label">Category Name <span class="required-star">*</span></label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    value="<%= category.name %>" 
                    maxlength="100" 
                    required
                    placeholder="e.g., Disaster Relief, Education"
                    class="form-control">
                <small class="form-help">Maximum of 100 characters allowed.</small>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/categories" class="btn btn-secondary">Cancel</a>
            </div>

        </form>
    </div>
</main>

<%- include('../partials/footer') %>
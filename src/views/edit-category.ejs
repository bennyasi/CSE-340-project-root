<%- include('partials/header') %>
<main style="max-width: 600px; margin: 40px auto; padding: 0 20px;">
    <h1>Edit Category</h1>

    <% if (locals.messages && messages.error) { %>
        <div class="alert alert-danger" style="background: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 20px; border-radius: 4px;">
            <%= messages.error %>
        </div>
    <% } %>

    <form action="/categories/update/<%= category.category_id %>" method="POST">
        <div class="form-group" style="margin-bottom: 20px;">
            <label for="name">Category Name</label>
            <input type="text" id="name" name="name" value="<%= category.name %>" minlength="2" maxlength="100" required style="width: 100%; padding: 8px;" />
        </div>
        <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px;">Update Category</button>
        <a href="/categories" style="margin-left: 15px;">Cancel</a>
    </form>
</main>
<%- include('partials/footer') %>
<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <p>Here are a few of our partner organizations:</p>

    <ul class="organization-list">

        <% organizations.forEach(organization => { %>

            <li class="org-item">

                <!-- LOGO -->
                <img
                    src="/images/<%= organization.logo_filename || 'default-logo.png' %>"
                    alt="<%= organization.name %> logo"
                    class="org-logo"
                    loading="lazy"
                >

                <div class="org-info">

                    <!-- CLICKABLE ORGANIZATION NAME -->
                    <strong>
                        <a href="/organizations/<%= organization.organization_id %>">
                            <%= organization.name %>
                        </a>
                    </strong>

                    <br>

                    <!-- CLICKABLE EMAIL -->
                    <a href="mailto:<%= organization.contact_email %>">
                        <%= organization.contact_email %>
                    </a>

                    <br>

                    <!-- OPTIONAL: LINK TO RELATED PROJECTS -->
                    <a href="/projects?org=<%= organization.organization_id %>">
                        View Projects
                    </a>

                    <br>

                    <!-- OPTIONAL: LINK TO CATEGORY FILTER -->
                    <a href="/categories?org=<%= organization.organization_id %>">
                        View Categories
                    </a>

                </div>

            </li>

        <% }) %>

    </ul>

</main>

<% if (typeof error !== 'undefined' && error.length > 0) { %>
    <div class="alert alert-danger">
        <%= error %>
    </div>
<% } %>

<%- include('partials/footer') %>
<p><a href="/new-organization">Add a new organization</a></p>
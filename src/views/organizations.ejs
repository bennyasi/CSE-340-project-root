<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    
    <ul>
        <% if (organizations && organizations.length > 0) { %>
            <% organizations.forEach(org => { %>
                <li>
                    <!-- Fixed: Closed the img tag properly with > -->
                    <img src="/images/<%= org.logo_filename %>" alt="<%= org.name %> Logo"> 
                    
                    <strong><%= org.name %></strong>: 
                    <!-- Enhanced: Made the email a clickable link -->
                    <a href="mailto:<%= org.contact_email %>"><%= org.contact_email %></a>
                </li>
            <% }) %>
        <% } else { %>
            <li>No organizations available at this time.</li>
        <% } %>
    </ul>
</main>

<%- include('partials/footer') %>s

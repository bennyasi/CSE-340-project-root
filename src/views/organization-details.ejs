<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <% if (organizationDetails) { %>

        <h2><%= organizationDetails.name %></h2>

        <p>
            <strong>Email:</strong>
            <a href="mailto:<%= organizationDetails.contact_email %>">
                <%= organizationDetails.contact_email %>
            </a>
        </p>

        <% if (organizationDetails.logo_filename) { %>
            <img
                src="/images/<%= organizationDetails.logo_filename %>"
                alt="<%= organizationDetails.name %> logo"
                width="150"
            >
        <% } %>

    <% } %>

    <hr>

    <h3>Projects by this Organization</h3>

    <ul>

        <% if (projects && projects.length > 0) { %>

            <% projects.forEach(project => { %>

                <li>

                    <strong>
                        <a href="/projects/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </strong>

                    <p><%= project.description %></p>

                </li>

            <% }) %>

        <% } else { %>

            <li>No projects available for this organization.</li>

        <% } %>

    </ul>

</main>

<%- include('partials/footer') %>
<%- include('partials/header') %>

<main>

    <%- include('partials/messages') %>

    <h1><%= title %></h1>

    <% if (organizationDetails) { %>

        <section class="organization-card">
            <h2><%= organizationDetails.name %></h2>

            <p>
                <strong>Email:</strong>
                <a href="mailto:<%= organizationDetails.contact_email %>">
                    <%= organizationDetails.contact_email %>
                </a>
            </p>

            <% if (organizationDetails.description) { %>
                <p><strong>Description:</strong> <%= organizationDetails.description %></p>
            <% } %>

            <div class="logo-container">
                <img 
                    src="<%= organizationDetails.logo_filename ? '/images/' + organizationDetails.logo_filename : '/images/placeholder-logo.png' %>" 
                    alt="<%= organizationDetails.name %> logo"
                    width="150"
                    onerror="this.src='/images/placeholder-logo.png'"
                >
            </div>

            <div class="organization-actions">
                <a href="/organizations/edit/<%= organizationDetails.organization_id %>" class="btn">Edit Organization</a>
            </div>
        </section>

    <% } else { %>
        <p>Organization not found.</p>
    <% } %>

    <hr>

    <section class="projects-section">
        <h3>Projects by this Organization</h3>

        <% if (projects && projects.length > 0) { %>
            <ul class="project-list">
                <% projects.forEach(project => { %>
                    <li class="project-item">
                        <strong>
                            <a href="/projects/<%= project.project_id %>"><%= project.title %></a>
                        </strong>
                        <p><%= project.description %></p>
                        <p><strong>Status:</strong> <%= project.status %></p>
                        
                        <a href="/projects/<%= project.project_id %>/categories" class="btn-small">
                            Assign Categories
                        </a>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No projects available for this organization.</p>
        <% } %>
    </section>

</main>

<%- include('partials/footer') %>
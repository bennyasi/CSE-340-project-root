<%- include('partials/header') %>
<main style="max-width: 600px; margin: 40px auto; padding: 0 20px;">
    <h1>Assign Categories to: <%= project.title %></h1>

    <% if (locals.messages && messages.error) { %>
        <div class="alert alert-danger" style="background: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 20px; border-radius: 4px;">
            <%= messages.error %>
        </div>
    <% } %>

    <form action="/projects/<%= project.project_id %>/categories" method="POST">
        <p>Select all categories that apply to this project:</p>
        
        <div class="checkbox-group" style="margin-bottom: 20px;">
            <% allCategories.forEach(category => { %>
                <div style="margin-bottom: 10px;">
                    <label>
                        <input 
                            type="checkbox" 
                            name="categoryIds" 
                            value="<%= category.category_id %>"
                            <%= currentCategoryIds.includes(category.category_id) ? 'checked' : '' %>
                        />
                        <%= category.name %>
                    </label>
                </div>
            <% }); %>
        </div>

        <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
            Save Assignments
        </button>
        <a href="/projects/<%= project.project_id %>" style="margin-left: 15px;">Cancel</a>
    </form>
</main>
<%- include('partials/footer') %>
<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <ul>
        <% if (projects && projects.length > 0) { %>
            <% projects.forEach(proj => { %>
                <li>
                    <strong><%= proj.title %></strong>: <%= proj.description %>
                </li>
            <% }) %>
        <% } else { %>
            <li>No projects available at this time.</li>
        <% } %>
    </ul>
</main>
<%- include('partials/footer') %>
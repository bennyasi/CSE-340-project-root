<%- include('partials/header') %>
<main style="max-width: 600px; margin: 40px auto; padding: 0 20px;">
    <h1>Edit Project</h1>

    <% if (locals.messages && messages.error) { %>
        <div class="alert alert-danger" style="background: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 20px; border-radius: 4px;">
            <%= messages.error %>
        </div>
    <% } %>

    <form action="/projects/update/<%= project.project_id %>" method="POST">
        <div class="form-group" style="margin-bottom: 15px;">
            <label for="title">Project Title</label>
            <input type="text" id="title" name="title" value="<%= project.title %>" minlength="3" maxlength="150" required style="width: 100%; padding: 8px;" />
        </div>
        <div class="form-group" style="margin-bottom: 15px;">
            <label for="description">Description</label>
            <textarea id="description" name="description" maxlength="500" required style="width: 100%; padding: 8px; height: 100px;"><%= project.description %></textarea>
        </div>
        <div class="form-group" style="margin-bottom: 15px;">
            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= project.location %>" maxlength="255" required style="width: 100%; padding: 8px;" />
        </div>
        <div class="form-group" style="margin-bottom: 15px;">
            <label for="date">Date</label>
            <input type="date" id="date" name="date" value="<%= project.date ? new Date(project.date).toISOString().split('T')[0] : '' %>" required style="width: 100%; padding: 8px;" />
        </div>
        <div class="form-group" style="margin-bottom: 20px;">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required style="width: 100%; padding: 8px;">
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>" <%= org.organization_id === project.organization_id ? 'selected' : '' %>>
                        <%= org.name %>
                    </option>
                <% }); %>
            </select>
        </div>
        <button type="submit" style="padding: 10px 20px; background-color: #007bff; color: white; border: none; border-radius: 4px;">Update Project</button>
        <a href="/projects" style="margin-left: 15px;">Cancel</a>
    </form>
</main>
<%- include('partials/footer') %>
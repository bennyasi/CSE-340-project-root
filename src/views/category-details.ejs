<%- include('partials/header') %>

<main>

    <h1><%= title %></h1>

    <% if (categoryDetails) { %>
        <h2><%= categoryDetails.name %></h2>
    <% } %>

    <h3>Projects in this Category</h3>

    <ul>

        <% if (projects && projects.length > 0) { %>

            <% projects.forEach(project => { %>

                <li>

                    <strong>
                        <a href="/projects/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </strong>

                    <p><%= project.description %></p>

                </li>

            <% }) %>

        <% } else { %>

            <li>No projects in this category.</li>

        <% } %>

    </ul>

</main>

<%- include('partials/footer') %>
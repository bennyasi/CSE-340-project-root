<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= typeof title !== 'undefined' ? title : 'CSE 340 Service Network' %></title>

    <link rel="stylesheet" href="/css/main.css">
</head>
<body>

<div class="wrapper">

    <nav class="sidebar">

        <a href="/">Home</a>
        <a href="/organizations">Organizations</a>
        <a href="/projects">Projects</a>
        <a href="/categories">Categories</a>

        <% if (!locals.user) { %>
            <a href="/register">Register</a>
            <a href="/login">Login</a>
        <% } %>

        <% if (locals.user) { %>
            <a href="/dashboard">Dashboard</a>
            <a href="/logout">Logout</a>
        <% } %>

        <% if (locals.user && locals.user.role_name === 'admin') { %>
            <a href="/users">Users</a>
            <a href="/new-organization">Add Organization</a>
            <a href="/new-project">Add Project</a>
            <a href="/new-category">Add Category</a>
        <% } %>

    </nav>

    <main class="content">
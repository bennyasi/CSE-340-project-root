<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>
    <ul>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
                <li><%= cat.name %></li>
            <% }) %>
        <% } else { %>
            <li>No categories available at this time.</li>
        <% } %>
    </ul>
</main>
<%- include('partials/footer') %>

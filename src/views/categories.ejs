<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Service Project Categories</h2>

    <ul class="organization-list">

        <% categories.forEach(category => { %>
            <li class="org-item">

                <a href="/categories/<%= category.category_id %>">
                    <%= category.name %>
                </a>

            </li>
        <% }); %>

    </ul>
</main>

<%- include('partials/footer') %>